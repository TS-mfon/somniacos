{
  "name": "somniacos",
  "private": true,
  "version": "1.0.0",
  "description": "SomniacOS: The Autonomous Economy Layer",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @somniacos/web dev",
    "build": "pnpm --filter @somniacos/web build",
    "lint": "pnpm --filter @somniacos/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "runtime": "pnpm --filter @somniacos/runtime dev",
    "indexer": "pnpm --filter @somniacos/indexer dev",
    "seed": "tsx scripts/seed.ts",
    "seed:onchain": "tsx scripts/seed-onchain-activity.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "contracts:test": "pnpm --filter @somniacos/contracts test",
    "contracts:deploy": "tsx scripts/deploy-contracts.ts",
    "contracts:deploy:os": "tsx scripts/deploy-os-kernel.ts",
    "contracts:deploy:token-factory": "tsx scripts/deploy-token-factory.ts"
  },
  "dependencies": {
    "next": "^15.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.50.4"
  }
}
